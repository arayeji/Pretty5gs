logger:
  file:
    path: @localstatedir@/log/open5gs/mme.log
#  level: error   # production: errors + ATTACH step breadcrumbs
#  domain:         # optional finer control without full debug:
#    mme: error
#    gtp: warn
#    s1ap: error
#    s6a: error
#    nas: warn

global:
  max:
    ue: 1024  # The number of UE can be increased depending on memory size.
#    peer: 64
#    tai: 4096  # Max TAC entries per GTP-C client (mme.gtpc.client.sgwc / .smf tac lists). Default: 4096.
#    eps_tai0_partial_list: 20000  # Max type-0 partial lists in mme.tai (16 TACs each). Default: 20000.

mme:
  # DEBUG/TRACE for matching IMSI prefixes only (also at logger level=error).
  # Runtime (no restart): GET http://<mme-metrics>:9090/admin/trace/imsi?imsi=99970
  #   list filters: ?imsi=list   clear all: ?force=1
#  trace_imsi:
#    - 99970
#    - 001010000000002
  freeDiameter: @sysconfdir@/freeDiameter/mme.conf
  s1ap:
    server:
      - address: 127.0.0.2
  gtpc:
    server:
      - address: 127.0.0.2
    client:
      sgwc:
        - address: 127.0.0.3
      smf:
        - address: 127.0.0.4
  metrics:
    server:
      - address: 127.0.0.2
        port: 9090
  gummei:
    - plmn_id:
        mcc: 999
        mnc: 70
      mme_gid: 2
      mme_code: 1
  tai:
    - plmn_id:
        mcc: 999
        mnc: 70
      tac: 1
#  attach_accept:
#    tai_list: serving_only       # serving_only | all (default: serving_only)
#    equivalent_plmn: true        # send EPLMN IE when equivalent_plmn set
#    equivalent_plmn_serving_only: true  # one visitor PLMN when matched
#    ims_voice_over_ps: true      # VoPS in EPS network feature (default: true)
#    t3402: false                  # T3402 IE in Accept (default: false, Huawei)
#    esm_cause_pdn_type_mismatch: true  # ESM #50/#51 (default: true)
#    legacy_gprs_qos: true        # 2G QoS/LLC/radio/PFI IEs (default: true)
#  Legacy top-level keys (same as attach_accept.*) are still accepted:
#  tai_list_in_accept: serving_only
#  ims_voice_over_ps_in_s1_mode: true
#  equivalent_plmn_serving_only: true
#  mip_home_agent_host_dns: true
#    Resolve home PGW from HSS MIP-Home-Agent-Host (Destination-Host/Realm)
#    via DNS and cache the result. Set to false to skip DNS and use only
#    mme.gtpc.client.smf / PGW list addresses. Default: true
#  omit_indication_on_gtp_csr: false
#    Omit GTP Indication IE on all Create Session Requests (global).
#  inbound_roam:
#    gtp_apn_format: fqdn          # received | fqdn (default: fqdn)
#    gtp_apn_lowercase: false
#    strip_pap_from_gtp_pco: false # also strips IPCP/5G PCO on home-PGW CSR
#    force_ipv4_pdn_on_home_pgw: false
#    zero_bearer_mbr_for_non_gbr: false
#    gtpc_plmn_id_is_imsi_plmn: true  # plmn_id on gtpc.client = IMSI HPLMN
#                                     # use serving_plmn_id for visited TAI
#    Home PGW (MIP-Home-Agent): GTP APN on S11; SGWC forwards on S5.
#  ambr_limit:
#    enabled: false
#    force: false
#    downlink: 200                 # Mbps when enabled
#    uplink: 200
#    Cap/sanitize HSS AMBR sentinels before GTP/NAS. Default: disabled.
#  equivalent_plmn:
#    - mcc: 999
#      mnc: 71
#    - mcc: 999
#      mnc: 72
#  (EPLMN send/filter: see attach_accept.equivalent_plmn* above)
  security:
    integrity_order : [ EIA2, EIA1, EIA0 ]
    ciphering_order : [ EEA0, EEA1, EEA2 ]
  network_name:
    full: Open5GS
    short: Next
  mme_name: open5gs-mme0
  time:
#    t3402:
#      value: 720   # seconds (default: 720 = 12 min, sent in Attach/TAU Accept)
#    t3412:
#      value: 600   # seconds (default: 600 = 10 min periodic TAU timer)
#    t3423:
#      value: 720   # seconds (optional, ISR CS fallback in Attach/TAU Accept)
#    t3413:
#      value: 6     # paging retransmit (default: 6 s)
#      max_count: 2
#    t3422:
#      value: 6     # detach request retransmit (default: 6 s)
#      max_count: 4
#    t3450:
#      value: 12    # after Attach/TAU Accept + ICS Request (default: 12 s)
#      max_count: 4
#    bearer_setup:
#      value: 12    # eNB "SAE bearer setup" equivalent: sets t3450 (attach/ICS)
#                   # and E-RAB Setup Request watchdog (default: 12 s)
#      max_count: 4
#      Aliases: sae_bearer_setup
#    t3460:
#      value: 6     # auth / security mode retransmit (default: 6 s)
#      max_count: 4
#    t3470:
#      value: 6     # identity request retransmit (default: 6 s)
#      max_count: 4
#    t3489:
#      value: 4     # ESM information request (default: 4 s)
#      max_count: 2
#    t3495:
#      value: 8     # deactivate EPS bearer context request (default: 8 s)
#      max_count: 4
#      Alias: nas_deactivate_bearer
#    sgs_ts6_1:
#      value: 10    # SGs Location Update (Ts6-1, TS 29.118); EPS-only fallback
#      Alias: ts6_1

################################################################################
# S1AP Server
################################################################################
#  o Listen on address available in `eth0` interface
#  ngap:
#    server:
#      - dev: eth0
#
################################################################################
# GTP-C Server
################################################################################
#  o Listen on IPv4 and IPv6
#  o Non-default UDP source/listen port (default 2123; use only if peer/firewall
#    requires it — home PGW must accept replies to this port)
#  gtpc:
#    server:
#      - address: 127.0.0.2
#        port: 2124
#      - address: ::1
#
################################################################################
# GTP-C Client
################################################################################
#  o SGW selection by serving PLMN (TAI PLMN) and/or home IMSI PLMN
#  o With inbound_roam.gtpc_plmn_id_is_imsi_plmn (default true),
#    plmn_id on sgwc/smf means IMSI home PLMN; use serving_plmn_id for TAI.
#  gtpc:
#    client:
#      sgwc:
#        - address: 127.0.0.3
#          plmn_id:              # IMSI 432/12 home subs -> this SGW
#            mcc: 999
#            mnc: 70
#        - address: 127.0.0.4
#          imsi_plmn_id:         # explicit IMSI PLMN (same as plmn_id above)
#            mcc: 999
#            mnc: 71
#        - address: 127.0.0.5
#          serving_plmn_id:      # visited TAI PLMN only (not inbound roam)
#            mcc: 999
#            mnc: 70
#        - address: 127.0.0.6
#
#  o SGW selection by eNodeB TAC
#   (either single TAC or multiple TACs, DECIMAL representation)
#  gtpc:
#    client:
#      sgwc:
#        - address: 127.0.0.3
#          tac: 26000
#        - address: 127.0.2.2
#          tac: [25000, 27000, 28000]
#
#  o SGW selection by e_cell_id(28bit)
#   (either single or multiple e_cell_id, HEX representation)
#  gtpc:
#    client:
#      sgwc:
#        - address: 127.0.0.3
#          e_cell_id: abcde01
#        - address: 127.0.2.2
#          e_cell_id: [12345, a9413, 98765]
#
#  o SMF/PGW selection by home IMSI PLMN and/or serving PLMN (list order matters:
#    put imsi_plmn_id entries before serving plmn_id / apn / default)
#  gtpc:
#    client:
#      smf:
#        - address: 127.0.0.5
#          imsi_plmn_id:
#            mcc: 999
#            mnc: 35
#        - address: 127.0.0.6
#          imsi_plmn_id:
#            mcc: 999
#            mnc: 70
#        - address: 127.0.0.4
#          plmn_id:
#            mcc: 999
#            mnc: 70
#
#  o SMF selection by APN
#  gtpc:
#    client:
#      smf:
#        - address: 127.0.0.4
#          apn: internet
#        - address: 127.0.0.5
#          apn: volte
#
#  o SMF selection by eNodeB TAC
#   (either single TAC or multiple TACs, DECIMAL representation)
#  gtpc:
#    client:
#      smf:
#        - address: 127.0.0.4
#          tac: 26000
#        - address: 127.0.2.4
#          tac: [25000, 27000, 28000]
#
#  o SMF selection by e_cell_id(28bit)
#   (either single or multiple e_cell_id, HEX representation)
#  gtpc:
#    client:
#      smf:
#        - address: 127.0.0.4
#          e_cell_id: abcde01
#        - address: 127.0.2.4
#          e_cell_id: [12345, a9413, 98765]
#
#  o One SGSN is defined.
#    If prefer_ipv4 is not true, [fd69:f21d:873c:fa::2] is selected.
#  gtpc:
#    client:
#      sgsn:
#        - address:
#          - 127.0.0.3
#          - fd69:f21d:873c:fa::2
#          routes:
#          - rai:
#              lai:
#                plmn_id:
#                  mcc: 001
#                  mnc: 01
#                lac: 43690
#              rac: 187
#            ci: 1223
#
#
#  o Two SGSNs are defined. Last one is used by default if no
#    matching RAI+CI route is found.
#  gtpc:
#    client:
#      sgsn:
#        - address:
#          - 127.0.0.3
#          - fd69:f21d:873c:fa::2
#          routes:
#          - rai:
#              lai:
#                plmn_id:
#                  mcc: 001
#                  mnc: 01
#                lac: 43690
#              rac: 187
#            ci: 1223
#        - name: sgsn3.open5gs.org
#          default_route: true
#
################################################################################
# SGaAP Server
################################################################################
#  o MSC/VLR
#  sgsap:
#    client:
#      - address: msc.open5gs.org # SCTP server address configured on the MSC/VLR
#        local_address: 127.0.0.2 # SCTP local IP addresses to be bound in the MME
#        map:
#          imsi_prefix: 99970   # optional; match IMSI (multi-operator map)
#          tai:
#            plmn_id:
#              mcc: 001
#              mnc: 01
#            tac: 10000
#            tac_end: 10999       # optional inclusive end; omit for single TAC
#          lai:
#            plmn_id:
#              mcc: 001
#              mnc: 01
#            lac: 43691
#        map:
#          tai:
#            plmn_id:
#              mcc: 002
#              mnc: 02
#            tac: 4132
#          lai:
#            plmn_id:
#              mcc: 002
#              mnc: 02
#            lac: 43692
#      - address:       # SCTP server address configured on the MSC/VLR
#          - 127.0.0.88
#          - 10.0.0.88
#          - 10.0.0.10
#          - 2001:db8:babe::88
#        local_address: # SCTP local IP addresses to be bound in the MME
#          - 127.0.0.2
#          - 192.168.1.4
#          - 2001:db8:cafe::2
#        map:
#          tai:
#            plmn_id:
#              mcc: 001
#              mnc: 01
#            tac: 4133
#          lai:
#            plmn_id:
#              mcc: 002
#              mnc: 02
#            lac: 43693
#
################################################################################
# 3GPP Specification
################################################################################
#  o GUMMEI
#  gummei:
#    - plmn_id:
#        mcc: 001
#        mnc: 01
#      mme_gid: 2
#      mme_code: 1
#    - plmn_id:
#        - mcc: 002
#          mnc: 02
#        - mcc: 003
#          mnc: 03
#      mme_gid: [3, 4]
#      mme_code:
#        - 2
#        - 3
#
#  o TAI
#  tai:
#    - plmn_id:
#        mcc: 001
#        mnc: 01
#      tac: [1, 3, 5]
#  tai:
#    - plmn_id:
#        mcc: 002
#        mnc: 02
#      tac: [6-10, 15-18]
#  tai:
#    - plmn_id:
#        mcc: 003
#        mnc: 03
#      tac: 20
#    - plmn_id:
#        mcc: 004
#        mnc: 04
#      tac: 21
#  tai:
#    - plmn_id:
#        mcc: 005
#        mnc: 05
#      tac: [22, 28]
#    - plmn_id:
#        mcc: 006
#        mnc: 06
#      tac: [30-32, 34, 36-38, 40-42, 44, 46, 48]
#    - plmn_id:
#        mcc: 007
#        mnc: 07
#      tac: 50
#    - plmn_id:
#        mcc: 008
#        mnc: 08
#      tac: 60
#    - plmn_id:
#        mcc: 009
#        mnc: 09
#      tac: [70, 80]
#
#  o Access Control
#  access_control:
#    - default_reject_cause: 13
#    - plmn_id:
#        reject_cause: 15
#        mcc: 001
#        mnc: 01
#    - plmn_id:
#        mcc: 002
#        mnc: 02
#    - plmn_id:
#        mcc: 999
#        mnc: 70
#
#  o HSS Selection
#    o realm and host are optional
#    o realm will be generated from plmn_id if not provided
#    o host will not be used if not provided
#  hss_map:
#    - plmn_id:
#        mcc: 001
#        mnc: 01
#    - plmn_id:
#        mcc: 002
#        mnc: 02
#      realm: epc.mnc002.mcc002.3gppnetwork.org
#    - plmn_id:
#        mcc: 999
#        mnc: 70
#      realm: localdomain
#      host: hss.localdomain
#
#  o Relative Capacity
#  relative_capacity: 100
