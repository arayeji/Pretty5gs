logger:
  file:
    path: @localstatedir@/log/open5gs/cgf.log
#  level: info   # fatal|error|warn|info(default)|debug|trace

global:
  max:
    ue: 1024

################################################################################
# open5gs-cgfd — GTP' CDR forwarder (3GPP Ga interface)
################################################################################
#
# The CGF forwarder reads ASN.1 BER CDR files produced by the SMF (see
# `smf.cdr:` in smf.yaml.in) out of a local spool directory and ships them
# to one or more Charging Gateway Functions over GTP' (TS 32.295). The
# forwarder is a separate process so a slow or unreachable CGF never
# blocks SMF session handling, and CDRs survive restarts on disk.
#
# Directory layout under `spool_dir` (mirrors the writer side):
#   current/     -- file being appended by the SMF
#   ready/       -- rotated files picked up by this daemon
#   processing/  -- only used when `workers` > 1: processing/<id>/
#                   holds the file(s) each drain worker has claimed
#   done/        -- files successfully delivered to a CGF
#   failed/      -- files quarantined (bad framing or all peers rejected)
#
cgf:
  spool_dir: @localstatedir@/spool/open5gs/cdr
  node_id: open5gs-cgf-1

  # Parallel drain workers (restart required to change this value).
  # 1 (default) = legacy single-thread behaviour: one drain pipeline
  # on the main thread, exactly as before this option existed.
  # N>1 spawns N independent drain worker threads, each opening its
  # own UDP association to every configured peer (own source port =>
  # own GTP' sequence/xact space, so the peer(s) must accept multiple
  # simultaneous associations from this host) and claiming disjoint
  # files out of ready/ (via atomic rename into processing/<id>/) so
  # workers never contend over the same CDR file. Peer/timer/batch
  # config changes made via the Admin API are still picked up live —
  # the worker pool is transparently restarted to apply them — but
  # changing `workers` itself needs a daemon restart.
  #workers: 4

  # How DTRRs are distributed across configured peers.
  #
  #   failover (default): only the primary (active) peer receives CDRs;
  #                       secondaries are used only when the active peer
  #                       is marked DOWN (missed echoes / DTRR give-up).
  #   round_robin:        active-active load balancing. Each newly
  #                       opened spool file is pinned to the next UP
  #                       peer in round-robin order for its lifetime
  #                       (or until that peer dies, then the file fails
  #                       over with Send-possibly-duplicated). Role
  #                       (primary/secondary) only picks the initial
  #                       RR cursor. Pair with `workers: N` (N >=
  #                       number of peers) so multiple files drain in
  #                       parallel across peers.
  #
  # Accepts: failover | round_robin | rr
  #send_mode: round_robin

  # Retention for fully-delivered CDR files.
  #
  #   false (default): on full ACK from a CGF peer, the spool file is
  #                    moved from ready/ to done/ and kept forever. Use
  #                    this if another process (backup, billing cross-
  #                    check, auditor) needs the local archive.
  #   true:            on full ACK, the spool file is unlink(2)'d.
  #                    Recommended on busy nodes where the CGF is the
  #                    system of record and local retention would fill
  #                    the disk.
  #
  # Files that fail all peers are always moved to failed/ for manual
  # inspection, regardless of this flag.
  #
  # Also hot-editable via the Admin API settings kind `cgfd:gtpp`.
  purge_on_success: false

  # One or more CGF peers.
  #
  # With send_mode=failover (default): the first "primary" entry wins
  # the active slot; secondaries are tried in declaration order on
  # failover. With send_mode=round_robin every UP peer is an equal
  # send target (see send_mode above).
  #
  # These fields (peer list + timers + batch) can also be hot-edited at
  # runtime via the Admin API settings kind `cgfd:gtpp`. The daemon
  # polls the Admin API periodically; a new revision will replace the
  # peer list without restarting. Existing sockets/xacts are preserved
  # for peers that stay in the new list (matched by host+port), new
  # peers are dialed, and removed peers are closed. See
  # tools/admin-api/README for the PUT /settings/cgfd:gtpp contract.
  # Note: send_mode itself is YAML-only (restart to change).
  peer:
    - address: 127.0.0.1
      port: 3386
      role: primary
#    - address: 10.0.0.51
#      port: 3386
#      role: secondary

  timers:
    echo_interval_s: 60              # GTP' Echo cadence
    request_rto_ms: 3000             # DTRR retransmit timeout
    request_retries: 4               # attempts before giving up on a peer
    failover_after_missed_echoes: 3  # consecutive missed echoes => DOWN
    spool_poll_ms: 250               # how often to scan ready/ for new files

  batch:
    # MTU-safe GTP' datagram size (no IP fragmentation). Throughput comes
    # from pipelining max_inflight DTRRs across max_active_files, not
    # oversized UDP. Round-robin only balances peers; these three knobs
    # (plus workers) are what drain a large ready/ queue.
    max_records_per_packet: 255
    max_bytes_per_packet: 1400
    max_inflight: 16
    # How many spool files one drain pipeline (main thread, or each
    # worker) may hold open at once. Defaults to max_inflight. Without
    # this >1, a file that has been fully sent but is still waiting for
    # ACKs stalls the whole pipeline — the main cause of ready/ backlog
    # when GA peers themselves are not overloaded.
    #max_active_files: 32

  # Data Record Packet IE sub-header. Four octets sitting between the
  # `fc <len>` TLIV header and the list of length-prefixed BER records:
  #
  #   Number of Records (1 B) | Format (1 B) | Format Version (2 B)
  #
  # Each record inside the IE is then preceded by its own 2-byte
  # big-endian length — that's the wire format Ericsson/Nokia CGFs
  # accept (note there is no Application Identifier octet here).
  # Defaults match the interop capture we validated against.
  # Accepts decimal or 0x-prefixed hex.
  #drp:
  #  data_record_format: 1                # 1=BER, 2=UNALIGNED_PER, 3=ALIGNED_PER, 4=XML
  #  data_record_format_version: 0x1906   # 16-bit vendor-defined
