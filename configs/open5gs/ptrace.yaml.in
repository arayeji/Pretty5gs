# Pretty-Trace — passive EPC/5GC probe for PrettyNMS
#
# Standalone NF: observes mirrored SPAN/TAP traffic. Does not modify
# or require hooks inside other network functions.
#
# Placeholders only — do not put production secrets or addresses here.

logger:
  file:
    path: @localstatedir@/log/open5gs/ptrace.log
#  level: info

global:
  max:
    ue: 1024

ptrace:
  capture:
    # pcap | afpacket | pfring (stub) | dpdk (stub)
    backend: pcap
    # Set for offline replay; leave empty for live interfaces
    pcap_file: ""
    workers: 4
    # Default BPF: untagged first, then vlan clause (order matters for libpcap).
    # Set include_gtpu: true only if you need S1-U user plane (very heavy).
    include_gtpu: false
    # Optional override. Prefer untagged-first if you add vlan:
    # bpf: "(sctp port 36412 or udp port 2123) or (vlan and (sctp port 36412 or udp port 2123))"
    # Live capture: list each SPAN/TAP NIC explicitly. No default NIC —
    # leave empty (or only use pcap_file) until the host interfaces are set.
    # role selects protocol demux hints: s1mme|s1u|s11|s5|s8|n3|n4|diameter
    # Live capture: list each SPAN/TAP NIC. Empty = no packets.
    # role: s1mme|s1u|s11|s5|s8|n3|n4|diameter
    interface: []
#   interface:
#     - dev: ens3f0
#       role: s1mme
#     # Diameter/S11 often NOT on the S1 SPAN — add them or IMSI is missed:
#     - dev: lo
#       role: diameter
#     - dev: ens3f1
#       role: s11

  cache:
    # Rolling metadata window: 1 | 5 | 10 | 15 | 60
    duration_minutes: 10
    pcap_ring_path: @localstatedir@/lib/open5gs/ptrace/ring
    pcap_ring_size_gb: 2

  redis:
    enabled: false
    # url: redis://127.0.0.1:6379

  clickhouse:
    enabled: false
    # url: http://127.0.0.1:8123/?query=INSERT%20INTO%20ptrace_events%20FORMAT%20JSONEachRow

  api:
    addr: 127.0.0.1
    port: 8088
