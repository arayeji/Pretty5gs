[Unit]
Description=Open5GS AMF Daemon
After=network-online.target

[Service]
Type=simple

User=open5gs
Group=open5gs

Restart=always
ExecStart=@bindir@/open5gs-amfd -c @sysconfdir@/open5gs/amf.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

# One file descriptor per gNB NGAP association plus SBI / GTP /
# metrics sockets. The systemd default (1024) is the classic
# cause of /metrics empty body / connection reset above ~1000
# gNBs (MHD accept() returns EMFILE).
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
