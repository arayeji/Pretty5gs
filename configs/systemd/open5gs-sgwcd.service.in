[Unit]
Description=Open5GS SGW-C Daemon
After=network-online.target

[Service]
Type=simple

User=open5gs
Group=open5gs

Restart=always
ExecStart=@bindir@/open5gs-sgwcd -c @sysconfdir@/open5gs/sgwc.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

# Bearer / session FDs scale with the served UE population; the
# default (1024) is far too low for any non-trivial deployment.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
