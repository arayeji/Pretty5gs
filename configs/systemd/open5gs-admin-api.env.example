# ==========================================================================
# Open5GS Admin API — environment file
# ==========================================================================
#
# Install as /etc/open5gs/admin-api.env  (owner root:open5gs, mode 0640).
#
# systemd loads this before starting open5gs-admin-api.service, so any
# value here is visible as an env var to the service process. None of
# it ends up in the journal.
#
# The service binary also reads appsettings.json next to itself. The
# order of precedence is: env var > appsettings.json > built-in default.
# ==========================================================================

# --- Bearer token used by every NF watcher (mandatory) --------------------
#
# Must match the `OPEN5GS_ADMIN_TOKEN` env var the NFs use. Generate
# with `openssl rand -hex 32` or similar. Rotate by dropping a new
# value here and `systemctl restart open5gs-admin-api`, then redeploy
# the NFs.
OPEN5GS_ADMIN_TOKEN=replace-me-with-a-long-random-string

# --- Listen URL (optional; default = http://0.0.0.0:9998 in appsettings) --
#
# Bind locally only while piloting:
#   ASPNETCORE_URLS=http://127.0.0.1:9998
# Expose to the admin LAN:
#   ASPNETCORE_URLS=http://10.0.0.5:9998
# TLS: use a proxy (nginx/caddy) or add HTTPS endpoints in appsettings.
#ASPNETCORE_URLS=http://0.0.0.0:9998

# --- MongoDB connection (optional; default = mongodb://127.0.0.1:27017) ---
#
# Override the connection string and/or the database name. Same keys
# as appsettings.json's "Mongo:*" section but using the ASP.NET Core
# env-var flattening convention:
#Mongo__ConnectionString=mongodb://127.0.0.1:27017
#Mongo__Database=open5gs_admin

# --- Logging (optional) ---------------------------------------------------
#
#Logging__LogLevel__Default=Information
#Logging__LogLevel__Microsoft.AspNetCore=Warning
