[Unit]
Description=Open5GS Pretty-Trace Daemon (passive EPC/5GC probe)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=open5gs
Group=open5gs

Restart=always
ExecStart=@bindir@/open5gs-ptraced -c @sysconfdir@/open5gs/ptrace.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

# Packet capture + API.
LimitNOFILE=1048576

# Live pcap / AF_PACKET need raw socket capability as non-root.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# Ring buffer directory (created by the daemon if missing).
ReadWritePaths=@localstatedir@/lib/open5gs/ptrace

[Install]
WantedBy=multi-user.target
