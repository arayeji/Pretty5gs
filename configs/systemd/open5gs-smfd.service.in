[Unit]
Description=Open5GS SMF Daemon
After=network-online.target

[Service]
Type=simple

User=open5gs
Group=open5gs

Restart=always
ExecStart=@bindir@/open5gs-smfd -c @sysconfdir@/open5gs/smf.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

# PFCP + SBI + Diameter Gx/Gy + metrics. The systemd default
# (1024) is the classic cause of /metrics empty body /
# connection reset above ~1000 active sessions.
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
