[Unit]
Description=Open5GS CGF Daemon (Ga / GTP' CDR forwarder)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=open5gs
Group=open5gs

Restart=always
ExecStart=@bindir@/open5gs-cgfd -c @sysconfdir@/open5gs/cgf.yaml
RestartSec=2
RestartPreventExitStatus=1
ExecReload=/bin/kill -HUP $MAINPID

# Spool dir must be writable by the open5gs user; created by the
# package postinst (see installer) but ReadWritePaths keeps it
# sandboxed if you re-enable ProtectSystem later.
#ReadWritePaths=@localstatedir@/spool/open5gs/cdr

[Install]
WantedBy=multi-user.target
