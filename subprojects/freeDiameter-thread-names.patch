 /*                          THREADS                           */
 /*============================================================*/
 
+
+/* pthread_setname_np: declare only when glibc headers did not (no _GNU_SOURCE).
+ * Open5GS builds define _GNU_SOURCE / __USE_GNU and already declare it. */
+#ifdef __linux__
+# ifndef __USE_GNU
+extern int pthread_setname_np(pthread_t thread, const char *name);
+# endif
+#endif
+
+/* Set pthread name (Linux: 15 chars max). No-op elsewhere / on NULL thr. */
+static __inline__ void fd_thr_setname(pthread_t th, const char *name)
+{
+#ifdef __linux__
+	if (th != (pthread_t)NULL && name != NULL)
+		(void) pthread_setname_np(th, name);
+#else
+	(void)th;
+	(void)name;
+#endif
+}
+
 /* Terminate a thread */
